{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sightmap",
  "main": ".open-next/worker.js",
  // nodejs_compat is required by the adapter; the date must be >= 2024-09-23
  // for it to take effect.
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "SCREENSHOTS",
      "bucket_name": "sightmap-screenshots"
    }
  ],
  "observability": {
    "enabled": true
  }
}
